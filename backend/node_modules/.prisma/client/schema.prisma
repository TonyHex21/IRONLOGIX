generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SAFETY_DIRECTOR
  SUPERVISOR
  SAFETY_TECH
}

enum IncidentStatus {
  DRAFT
  SUBMITTED
  SUPERVISOR_REVIEWED
  DIRECTOR_APPROVED
  LOCKED
}

enum ViolationStatus {
  ISSUED
  ACKNOWLEDGED
  DIRECTOR_REVIEWED
  CLOSED
}

enum InspectionResult {
  PASS
  FAIL
  OUT_OF_SERVICE
}

model Company {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users       User[]
  incidents   Incident[]
  violations  Violation[]
  inspections Inspection[]
}

model User {
  id        String   @id @default(uuid())
  companyId String
  name      String
  email     String   @unique
  role      UserRole
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  incidentsReported Incident[]   @relation("IncidentsReported")
  violationsIssued  Violation[]  @relation("ViolationsIssued")
  inspectionsDone   Inspection[] @relation("InspectionsDone")
}

model Incident {
  id           String         @id @default(uuid())
  companyId    String
  reportedById String
  incidentType String
  description  String
  occurredAt   DateTime
  status       IncidentStatus @default(DRAFT)
  createdAt    DateTime       @default(now())

  company    Company @relation(fields: [companyId], references: [id])
  reportedBy User    @relation("IncidentsReported", fields: [reportedById], references: [id])
}

model Violation {
  id                 String          @id @default(uuid())
  companyId          String
  issuedById         String
  category           String
  description        String
  correctiveAction   String?
  retrainingRequired Boolean         @default(false)
  status             ViolationStatus @default(ISSUED)
  createdAt          DateTime        @default(now())

  company  Company @relation(fields: [companyId], references: [id])
  issuedBy User    @relation("ViolationsIssued", fields: [issuedById], references: [id])
}

model Inspection {
  id             String           @id @default(uuid())
  companyId      String
  performedById  String
  inspectionType String
  checklistName  String
  result         InspectionResult
  notes          String?
  performedAt    DateTime
  createdAt      DateTime         @default(now())

  company     Company @relation(fields: [companyId], references: [id])
  performedBy User    @relation("InspectionsDone", fields: [performedById], references: [id])
}
